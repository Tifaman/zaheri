# ZaHeri — environment variables
# Copy to .env and fill in. Never commit the real .env.

# --- Phase 0: database ---
DATABASE_URL=postgresql://user:password@localhost:5432/zaheri

# --- Phase 1: auth ---
JWT_SECRET=
JWT_EXPIRES_IN=15m

# --- Phase 2: queue + notifications ---
REDIS_URL=redis://localhost:6379

# --- Deploy: cross-origin frontend ---
# Comma-separated list of allowed origins for the deployed web frontend
# (e.g. https://zaheri-web.onrender.com). '*' (default) allows any origin —
# fine for a demo deploy, not for real patient data. See render.yaml.
CORS_ORIGIN=*
# SMS / WhatsApp gateway (e.g. Africa's Talking, Twilio, WhatsApp Cloud API)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Phase 3: verified pharmacy receipt ---
# Secret used to sign the QR receipt; verify signature + single use on scan
RECEIPT_SIGNING_KEY=

# --- Phase 4: GPS pharmacy locator ---
MAPS_API_KEY=            # Mapbox or Google Maps JS SDK
# PHARM.LINK — external pharmacy stock/price (future / optional; add when ready)
# PHARM_LINK_BASE_URL=
# PHARM_LINK_API_KEY=

# --- Phase 5: NHIF + voice ---
# NHIF insurance eligibility / billing — obtain from NHIF
NHIF_BASE_URL=
NHIF_API_KEY=
# Text-to-speech for dynamic Swahili lines (drug names, room/queue numbers)
TTS_API_KEY=             # ElevenLabs or Soniox

# --- Cross-cutting: hospital integration ---
# GoTHOMIS / HL7 FHIR — obtain from Muhimbili IT / MoH (mocked until available)
GOTHOMIS_BASE_URL=
GOTHOMIS_API_KEY=
