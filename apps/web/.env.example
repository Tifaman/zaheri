# ZaHeri web — build-time environment variables (Vite bakes these in at
# build time; copy to .env.local for a local override, never commit .env*).

# Leave unset for local dev — vite.config.ts already proxies /api and
# /socket.io to the local API. Set to the deployed API's public URL
# (e.g. https://zaheri-api.onrender.com) when building for production,
# since the frontend and API are separate origins there — see render.yaml.
VITE_API_BASE_URL=
